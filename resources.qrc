<!DOCTYPE RCC>
<RCC version="1.0">
  <qresource prefix="/icons">
    <file alias="house.svg">resources/icons/house.svg</file>
    <file alias="library.svg">resources/icons/library.svg</file>
    <file alias="settings.svg">resources/icons/settings.svg</file>
    <file alias="plus.svg">resources/icons/plus.svg</file>
    <file alias="arrow_left.svg">resources/icons/arrow_left.svg</file>
    <file alias="users.svg">resources/icons/users.svg</file>
    <file alias="x.svg">resources/icons/x.svg</file>
    <file alias="play.svg">resources/icons/play.svg</file>
    <file alias="rotate_cw_clock.svg">resources/icons/rotate_cw_clock.svg</file>
    <file alias="folder_pen.svg">resources/icons/folder_pen.svg</file>
  </qresource>
  <qresource>
    <file alias="Quicksand-Bold.ttf">resources/Quicksand-Bold.ttf</file>
    <file alias="Quicksand-Light.ttf">resources/Quicksand-Light.ttf</file>
    <file alias="Quicksand-Medium.ttf">resources/Quicksand-Medium.ttf</file>
    <file alias="Quicksand-Regular.ttf">resources/Quicksand-Regular.ttf</file>
    <file alias="Quicksand-SemiBold.ttf">resources/Quicksand-SemiBold.ttf</file>
    <file alias="app-icon.png">resources/app-icon.png</file>
  </qresource>
  <qresource prefix="/audio">
    <file alias="sidebar_click.wav">resources/audio/i4.wav</file>
    <file alias="dialog_open.wav">resources/audio/i3.wav</file>
    <file alias="dialog_danger_open.wav">resources/audio/i1.wav</file>
    <file alias="navigation.wav">resources/audio/n1.wav</file>
  </qresource>
</RCC>
