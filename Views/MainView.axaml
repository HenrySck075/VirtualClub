<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:VirtualClub.Views"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="VirtualClub.Views.MainView"
             x:CompileBindings="True"
             x:DataType="local:MainViewModel">
   <UserControl.Resources>
        <!-- Removes vertical spacing reserved for the pane header/search box -->
        <Thickness x:Key="NavigationViewAutoCompleteBoxMargin">0</Thickness>
        <Thickness x:Key="NavigationViewHeaderMargin">0</Thickness>
    </UserControl.Resources>
        <!-- Search Bar embedded in the title bar area -->
        <ui:FANavigationView x:Name="NavView" 
                           IsSettingsVisible="True"
                           IsBackButtonVisible="True"
                           IsPaneToggleButtonVisible="False"
                           IsBackEnabled="{Binding CanGoBack, RelativeSource={RelativeSource AncestorType=local:MainView}}"
                           BackRequested="NavView_BackRequested"
                           PaneDisplayMode="Left"
                           >
            <!-- this creates a space below the back button. i know what it was for but idk why -->
            <ui:FANavigationView.ContentOverlay>
                <AutoCompleteBox x:Name="ModSearchBox" 
                        PlaceholderText="Search for a mod" 
                        Width="300" 
                        HorizontalAlignment="Center" 
                        Margin="0,10,0,10"
                        ItemsSource="{Binding Items}"
                        ValueMemberBinding="{Binding Name}"
                        ItemFilter="SearchFilter"
                        SelectionChanged="ModSearchBox_SelectionChanged"
                        >
                    <AutoCompleteBox.ItemTemplate>
                        <DataTemplate DataType="local:SearchItem">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                </AutoCompleteBox>
            </ui:FANavigationView.ContentOverlay>



            <ui:FANavigationView.MenuItems>
                <ui:FANavigationViewItem Content="Home" Tag="home" IconSource="Home" x:Name="amogus"/>
                <ui:FANavigationViewItem Content="Mods" Tag="list" IconSource="Library" />
            </ui:FANavigationView.MenuItems>

            <ui:FANavigationView.FooterMenuItems>
                <ui:FANavigationViewItem Content="About" Tag="about" IconSource="ContactInfo" />
            </ui:FANavigationView.FooterMenuItems>
        
            <!-- Content Frame for Page Navigation -->
            <Border Background="{DynamicResource SurfaceBackgroundFillColorSecondaryBrush}" Padding="12">
                <ui:FAFrame x:Name="ContentFrame" DataContext="{x:Null}" />
            </Border>
        </ui:FANavigationView>
    
</UserControl>