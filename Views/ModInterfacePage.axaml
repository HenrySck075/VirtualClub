<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:local="using:VirtualClub.Views"
             x:Class="VirtualClub.Views.ModInterfacePage"
             x:DataType="local:ModInterfacePageModel">

    <ScrollViewer Padding="36,24">
        <StackPanel Spacing="8">
            
            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*" RowSpacing="16" ColumnSpacing="16">
                <Image x:Name="ModIcon" Width="120" Height="120" Source="{Binding IconPath}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="ModTitle" Text="{Binding Name}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="ModVersion" Text="{Binding Version, StringFormat=Version {0}}" Foreground="Gray" />
                    <TextBlock x:Name="ModDirectory" Text="{Binding Directory}" Foreground="Gray" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" >
                        <SplitButton Click="OnStartClicked" Classes="accent">
                            <SplitButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ui:FASymbolIcon Symbol="Play" />
                                    <TextBlock Text="Start" />
                                </StackPanel>
                            </SplitButton.Content>
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Start from save" Click="OnStartFromSaveClicked" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <Button>
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ui:FASymbolIcon Symbol="Edit" />
                                    <TextBlock Text="Edit" />
                                </StackPanel>
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="8" Margin="8">
                                        <TextBlock Text="Name"></TextBlock>
                                        <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                        <TextBlock Text="Version"></TextBlock>
                                        <TextBox Text="{Binding Version, Mode=TwoWay}" />
                                        <TextBlock Text="Directory"></TextBlock>
                                        <TextBlock Text="{Binding Directory}">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="Gray" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <Button Content="Change directory" Click="OnChangeDirectoryClicked" />
                                        <TextBlock Text="Icon"></TextBlock>
                                        <Image Width="64" Height="64" Source="{Binding IconPath}" HorizontalAlignment="Center"/>
                                        <Button Content="Change icon" Click="OnChangeIconClicked" />

                                        <Button Content="Save" Click="OnSaveMetaEditClicked" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Separator />

            <!-- Playtime -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,8">
                <ui:FASymbolIcon Symbol="Clock" />
                <TextBlock VerticalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Playtime: {0} (Active: {1})">
                            <Binding Path="PlaytimeText" />
                            <Binding Path="ActivePlaytimeText" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <!-- Mod Management Cards -->
            <ui:FASettingsExpander Header="Open virtual folder" 
                            Description="If mods ask you to delete scripts.rpa, delete them through here." 
                            IconSource="Folder">
                <ui:FASettingsExpander.Footer>
                    <Button Content="Open" Click="OnOpenVirtualFolderClicked" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="Developer mode" 
                            Description="Toggle developer tools in the game." 
                            IconSource="Code">
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch x:Name="DevModeToggle" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="Force recompile" 
                            Description="Force the engine to recompile any loose .rpyc files on launch." 
                            IconSource="Sync">
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch x:Name="ForceRecompileToggle" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="Remove mod" 
                            Description="Delete mod deployment indices and meta configs." 
                            IconSource="Delete">
                <ui:FASettingsExpander.Footer>
                    <Button Content="Uninstall" Classes="accent" Click="OnUninstallClicked" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>