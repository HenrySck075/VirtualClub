<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:local="using:VirtualClub.Views"
             x:Class="VirtualClub.Views.ModInterfacePage"
             x:DataType="local:ModInterfacePageModel">

    <ScrollViewer Padding="36,24">
        <StackPanel Spacing="8">
            
            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*" RowSpacing="16" ColumnSpacing="16">
                <Image x:Name="ModIcon" Width="120" Height="120" Source="{Binding Icon}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="ModTitle" Text="{Binding Name}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="ModVersion" Text="{Binding Version, StringFormat=Version {0}}" Foreground="Gray" />
                    <TextBlock x:Name="ModDirectory" Text="{Binding Directory}" Foreground="Gray" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" >
                        <SplitButton Click="OnStartClicked" Classes="accent" IsEnabled="{Binding IsSessionNotRunning}">
                            <SplitButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ui:FASymbolIcon Symbol="Play" />
                                    <TextBlock Text="Start" />
                                </StackPanel>
                            </SplitButton.Content>
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Start from save" Click="OnStartFromSaveClicked" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <Button IsEnabled="{Binding IsSessionNotRunning}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ui:FASymbolIcon Symbol="Edit" />
                                    <TextBlock Text="Edit" />
                                </StackPanel>
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="8" Margin="8" MinWidth="300">
                                        <TextBlock Text="Name"></TextBlock>
                                        <TextBox Text="{Binding Name, Mode=TwoWay}" />
                                        <TextBlock Text="Version"></TextBlock>
                                        <TextBox Text="{Binding Version, Mode=TwoWay}" />
                                        <TextBlock Text="Directory"></TextBlock>
                                        <Button Content="Change directory" Click="OnChangeDirectoryClicked" />
                                        <TextBlock Text="Icon"></TextBlock>
                                        <Image Width="64" Height="64" Source="{Binding Icon}" HorizontalAlignment="Center"/>
                                        <Button Content="Change icon" Click="OnChangeIconClicked" />

                                        <Button Content="Save" Click="OnSaveMetaEditClicked" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Separator />

            <StackPanel Spacing="8">
                <TextBlock Text="Tags" FontSize="16" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="4,2">
                                <TextBlock Text="{Binding Name}" />
                                <!--
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{Binding Color}" />
                                </Border.BorderBrush>
                                -->
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!--the add tag button-->
                <Button Content="Add tag"  HorizontalAlignment="Left" />
            </StackPanel>
            <Separator />

            <!-- Playtime -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,8">
                <ui:FASymbolIcon Symbol="Clock" />
                <TextBlock VerticalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Playtime: {0} (Active: {1})">
                            <Binding Path="PlaytimeText" />
                            <Binding Path="ActivePlaytimeText" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <!-- Mod Management Cards -->
            <ui:FASettingsExpander Header="Open virtual folder" 
                            Description="If mods ask you to delete scripts.rpa, delete them through here." 
                            IconSource="Folder">
                <ui:FASettingsExpander.Footer>
                    <Button Content="Open" Click="OnOpenVirtualFolderClicked" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="Developer mode" 
                            Description="Toggle developer tools in the game." 
                            IconSource="Code">
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch x:Name="DevModeToggle" IsCheckedChanged="DevModeToggle_IsCheckedChanged" IsEnabled="{Binding IsSessionNotRunning}" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="Force recompile" 
                            Description="Force the engine to recompile any loose .rpyc files on launch." 
                            IconSource="Sync">
                <ui:FASettingsExpander.Footer>
                    <ToggleSwitch x:Name="ForceRecompileToggle" IsCheckedChanged="ForceRecompileToggle_IsCheckedChanged" IsEnabled="{Binding IsSessionNotRunning}" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="Remove mod" 
                            Description="Delete mod deployment indices and meta configs." 
                            IconSource="Delete">
                <ui:FASettingsExpander.Footer>
                    <Button Content="Uninstall" Classes="accent" Click="OnUninstallClicked" IsEnabled="{Binding IsSessionNotRunning}" />
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>